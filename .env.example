NODE_ENV=development
PORT=3000

# Supabase Postgres. DATABASE_URL = Supavisor transaction pooler (6543).
# DIRECT_URL = direct connection (5432), used only by `prisma migrate`.
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"

BETTER_AUTH_SECRET="generate-a-32+char-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

RESEND_API_KEY=""
# Must be a domain VERIFIED in Resend (SPF/DKIM added in your DNS, see
# Resend's Domains page). "Display Name <email@domain>" or a bare
# "email@domain" both work. NEVER an @resend.dev address in production —
# that shared test sender only delivers to the Resend account owner's own
# inbox, and env.ts refuses to boot with NODE_ENV=production if it sees one.
EMAIL_FROM="Portfolio Builder <noreply@ourapp.com>"

SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_BUCKET="portfolio-uploads"

# Absolute paths. In production TEMPLATES_DIR should point at a checkout of
# portfolio-builder-templates where `bun run build && bun run prewarm` has
# already run.
TEMPLATES_DIR="/absolute/path/to/portfolio-builder-templates"
PORTFOLIOS_DIR="/absolute/path/to/portfolios"
BUILD_TMP_DIR="/absolute/path/to/build-tmp"

PORTFOLIO_DOMAIN="ourapp.com"
MAX_CONCURRENT_BUILDS=2
BUILD_TIMEOUT_MS=120000
RELEASES_TO_KEEP=5

WEB_ORIGIN="http://localhost:5173"
COOKIE_DOMAIN=".ourapp.com"

# Extra subdomains to block, merged with the built-in blocklist in
# src/lib/slug.ts (www, api, app, admin, mail, …) — this can only ADD
# reserved names, never remove one. Comma/space separated.
RESERVED_SLUGS="status,cdn2,internal"

# debug | info | warn | error. debug is very chatty (logs every asset
# localized, every build step) — use info in production.
LOG_LEVEL="info"
